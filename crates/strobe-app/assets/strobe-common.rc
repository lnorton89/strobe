// The Windows resources both executables share (R-06, D241, D244): the
// icon Explorer, the taskbar and the Start menu show, and the version
// block a file's Properties > Details tab reads. The file that includes
// this one defines FILE_NAME and FILE_DESCRIPTION; build.rs defines
// ICON_PATH (assets/brand/icon.ico, absolute), VER_MAJOR, VER_MINOR,
// VER_PATCH and VER_STRING from the crate's version.
//
// The numbers are spelled out instead of winver.h's names (VOS_NT_WINDOWS32,
// VFT_APP) so the file needs no SDK header and compiles with llvm-rc too.

1 ICON ICON_PATH

1 VERSIONINFO
FILEVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
PRODUCTVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
FILEFLAGSMASK 0x3F
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x1
FILESUBTYPE 0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // US English, Unicode: the pair VarFileInfo's Translation names.
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "strobe contributors"
            VALUE "FileDescription", FILE_DESCRIPTION
            VALUE "FileVersion", VER_STRING
            VALUE "InternalName", FILE_NAME
            VALUE "LegalCopyright", "Copyright (c) 2026 strobe contributors. MIT License."
            VALUE "OriginalFilename", FILE_NAME
            VALUE "ProductName", "Strobe"
            VALUE "ProductVersion", VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
